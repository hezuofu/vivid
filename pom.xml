<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.vividframework</groupId>
    <artifactId>vivid-framework</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>Vivid Framework</name>
    <description>A Spring-like Java Web Framework</description>

    <modules>
        <module>vivid-core</module>
        <module>vivid-beans</module>
        <module>vivid-context</module>
        <module>vivid-aop</module>
        <module>vivid-web</module>
        <module>vivid-webmvc</module>
        <module>vivid-boot</module>
        <module>vivid-jdbc</module>
        <module>vivid-tx</module>
        <module>vivid-security</module>
    </modules>

    <properties>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <slf4j.version>2.0.9</slf4j.version>
        <logback.version>1.4.11</logback.version>
        <jackson.version>2.16.0</jackson.version>
        <netty.version>4.1.97.Final</netty.version>
        <hibernate.version>6.3.1.Final</hibernate.version>
        <hikari.version>5.1.0</hikari.version>
        <cglib.version>4.3</cglib.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal Modules -->
            <dependency>
                <groupId>org.vividframework</groupId>
                <artifactId>vivid-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vividframework</groupId>
                <artifactId>vivid-beans</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vividframework</groupId>
                <artifactId>vivid-context</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vividframework</groupId>
                <artifactId>vivid-aop</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vividframework</groupId>
                <artifactId>vivid-web</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vividframework</groupId>
                <artifactId>vivid-webmvc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vividframework</groupId>
                <artifactId>vivid-boot</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vividframework</groupId>
                <artifactId>vivid-jdbc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vividframework</groupId>
                <artifactId>vivid-tx</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vividframework</groupId>
                <artifactId>vivid-security</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- SLF4J & Logback -->
            <dependency>
                <groupId>org.slf4j</groupId>
                <artifactId>slf4j-api</artifactId>
                <version>${slf4j.version}</version>
            </dependency>
            <dependency>
                <groupId>ch.qos.logback</groupId>
                <artifactId>logback-classic</artifactId>
                <version>${logback.version}</version>
            </dependency>

            <!-- Jackson -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>
            <dependency>
                <groupId>com.fasterxml.jackson.datatype</groupId>
                <artifactId>jackson-datatype-jsr310</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- Netty -->
            <dependency>
                <groupId>io.netty</groupId>
                <artifactId>netty-all</artifactId>
                <version>${netty.version}</version>
            </dependency>

            <!-- Hibernate -->
            <dependency>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-core</artifactId>
                <version>${hibernate.version}</version>
            </dependency>

            <!-- HikariCP -->
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikari.version}</version>
            </dependency>

            <!-- CGLIB -->
            <dependency>
                <groupId>cglib</groupId>
                <artifactId>cglib</artifactId>
                <version>${cglib.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.11.0</version>
                    <configuration>
                        <source>17</source>
                        <target>17</target>
                        <encoding>UTF-8</encoding>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <version>3.3.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>3.6.2</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
